{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CacheBucket",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::better-every-day-cache-*",
        "arn:aws:s3:::better-every-day-cache-*/*"
      ]
    },
    {
      "Sid": "CacheRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::acc-id:role/better-every-day-cache-*"
    }
  ]
}
